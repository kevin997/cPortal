// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// User Model for Authentication
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?
  name          String
  password      String
  role          String   @default("sales_agent") // admin, creative_director, social_media_manager, collaborator, sales_agent, sales_rep, sales_manager, referrer
  avatar        String?
  referralCode  String?  @unique
  walletBalance        Int       @default(0) // Accumulated rewards in XAF
  twoFactorCode        String?
  twoFactorExpiry      DateTime?
  twoFactorAttempts    Int       @default(0)
  twoFactorVerifiedAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  students       Student[]
  enrollments    Enrollment[]
  leads          Lead[] // Leads referred by this user
  cashOperations CashOperation[]
  upcomingPayments UpcomingPayment[]
  cashForecasts  CashForecast[]
  cashSettings   CashSettings?
  createdUsers   User[]                  @relation("UserCreator")
  createdBy      User?                   @relation("UserCreator", fields: [createdById], references: [id])
  createdById    String?
  createdCreativeRequests  CreativeRequest[]     @relation("CreativeRequestCreator")
  assignedCreativeRequests CreativeRequest[]     @relation("CreativeRequestAssignee")
  createdCreativeDeliverables CreativeDeliverable[] @relation("CreativeDeliverableCreator")
  ownedCreativeDeliverables   CreativeDeliverable[] @relation("CreativeDeliverableOwner")
  uploadedCreativeAssets      CreativeAsset[]        @relation("CreativeAssetUploader")
  createdSocialMediaPlans     SocialMediaPlan[]      @relation("SocialMediaPlanCreator")

  @@map("users")
}

// Promotion Model for Referral Campaigns
model Promotion {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  rewardAmount    Int // Referrer reward in XAF
  discountPercent Int // Referee discount percentage
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  leads Lead[]

  @@map("promotions")
}

// Lead Model for Referral Tracking
model Lead {
  id          String    @id @default(cuid())
  name        String
  phone       String
  email       String?
  referrerId  String
  promotionId String
  status      String    @default("pending") // pending, contacted, converted, lost
  notes       String?   @db.Text
  convertedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  referrer  User      @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@map("leads")
}

// Student Model
model Student {
  id            String    @id @default(cuid())
  fullName      String
  email         String    @unique
  phoneNumber   String
  neighbourhood String?
  address       String?
  dateOfBirth   DateTime?
  gender        String?
  paymentStatus String    @default("pending") // paid, partially_paid, pending, overdue, cancelled
  totalAmountDue Int      @default(0)
  amountPaid    Int       @default(0)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String

  // Relations
  createdBy   User         @relation(fields: [createdById], references: [id])
  enrollments Enrollment[]

  @@map("students")
}

// Bootcamp Session Model
model BootcampSession {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  startDate       DateTime
  endDate         DateTime
  targetCapacity  Int
  currentCapacity Int      @default(0)
  status          String   @default("upcoming") // upcoming, ongoing, completed, cancelled
  location        String?
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  enrollments Enrollment[]

  @@map("bootcamp_sessions")
}

// Enrollment Model (Students to Bootcamp Sessions)
model Enrollment {
  id                String   @id @default(cuid())
  studentId         String
  bootcampSessionId String
  enrolledById      String
  enrollmentDate    DateTime @default(now())
  status            String   @default("enrolled") // enrolled, completed, dropped, transferred
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bootcampSession BootcampSession @relation(fields: [bootcampSessionId], references: [id], onDelete: Cascade)
  enrolledBy      User            @relation(fields: [enrolledById], references: [id])

  @@unique([studentId, bootcampSessionId])
  @@map("enrollments")
}

// Cash Operation Model (Caisse — entrées/sorties de caisse)
model CashOperation {
  id          String   @id @default(cuid())
  type        String   // "in" (entrée) | "out" (sortie)
  amount      Int      // Amount in XAF/FCFA
  category    String
  description String?  @db.Text
  date        DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cash_operations")
}

// Cash Settings Model (targets + Telegram credentials per user)
model CashSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  annualTarget     Int      @default(50000000)
  monthlyTarget    Int      @default(4000000)
  telegramBotToken String?
  telegramChatId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("cash_settings")
}

// Upcoming Payment Model (Caisse — paiements planifies)
model UpcomingPayment {
  id              String   @id @default(cuid())
  beneficiaryName String
  beneficiaryType String   // vendor, investor, partner, other
  amount          Int
  dueDate         DateTime
  status          String   @default("pending") // pending, paid, partially_paid, overdue, cancelled
  notes           String?  @db.Text
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("upcoming_payments")
}

// Cash Forecast Model (Caisse — previsions)
model CashForecast {
  id          String   @id @default(cuid())
  department  String
  quantity    Int
  unitPrice   Int
  total       Int
  deadline    DateTime
  report      String?  @db.Text
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cash_forecasts")
}

model CreativeRequest {
  id                       String   @id @default(cuid())
  reference                String   @unique
  requestDate              DateTime
  requesterName            String
  requesterFunction        String?
  servicePole              String?
  clientName               String?
  accountManager           String?
  clientApproverContact    String?
  contentType              String
  platform                 String?
  objective                String?
  campaignName             String?
  mainMessage              String?  @db.Text
  callToAction             String?
  copyProvided             Boolean  @default(false)
  copywriterName           String?
  desiredFormat            String?
  quantity                 Int?
  language                 String?
  includeLogo              Boolean  @default(false)
  brandGuidelinesProvided  Boolean  @default(false)
  priceToDisplay           String?
  dateToDisplay            String?
  timeToDisplay            String?
  locationToDisplay        String?
  contactNumber            String?
  linkUrl                  String?
  hashtags                 String?  @db.Text
  legalMentions            String?  @db.Text
  partnersSponsors         String?
  mandatoryElements        String?  @db.Text
  photosAvailable          Boolean  @default(false)
  videosAvailable          Boolean  @default(false)
  logoAvailable            Boolean  @default(false)
  sourceTextAvailable      Boolean  @default(false)
  visualReferences         String?  @db.Text
  referenceLinks           String?  @db.Text
  assetLocation            String?
  creativeDueDate          DateTime?
  publicationDate          DateTime?
  publicationTime          String?
  urgency                  String   @default("normal") // normal, urgent, overdue
  validationRequired       String   @default("internal_only") // internal_only, client_internal
  feedbackRounds           Int?
  requesterValidation      String?
  marketingValidation      String?
  clientValidation         String?
  finalValidation          String?
  additionalNotes          String?  @db.Text
  workflowStatus           String   @default("brief_received")
  workflowResponsible      String?
  workflowDate             DateTime?
  createdById              String
  assignedToId             String?
  socialMediaPlanId        String?
  socialMediaPlanTitle     String?
  socialMediaCaptionHtml   String?  @db.Text
  socialMediaAdCopyHtml    String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  createdBy   User                  @relation("CreativeRequestCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo  User?                 @relation("CreativeRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  deliverables CreativeDeliverable[]
  assets      CreativeAsset[]
  socialMediaPlan SocialMediaPlan?  @relation(fields: [socialMediaPlanId], references: [id], onDelete: SetNull)

  @@index([publicationDate])
  @@index([workflowStatus])
  @@index([assignedToId])
  @@index([socialMediaPlanId])
  @@map("creative_requests")
}

model CreativeDeliverable {
  id          String   @id @default(cuid())
  requestId   String
  title       String
  platform    String?
  format      String?
  scheduledFor DateTime
  status      String   @default("planned") // planned, in_progress, delivered, published
  notes       String?  @db.Text
  socialMediaPlanId      String?
  socialMediaPlanTitle   String?
  socialMediaCaptionHtml String?  @db.Text
  socialMediaAdCopyHtml  String?  @db.Text
  createdById String
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request   CreativeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdBy User            @relation("CreativeDeliverableCreator", fields: [createdById], references: [id], onDelete: Cascade)
  owner     User?           @relation("CreativeDeliverableOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  socialMediaPlan SocialMediaPlan? @relation(fields: [socialMediaPlanId], references: [id], onDelete: SetNull)

  @@index([scheduledFor])
  @@index([status])
  @@index([ownerId])
  @@index([socialMediaPlanId])
  @@map("creative_deliverables")
}

model CreativeAsset {
  id               String   @id @default(cuid())
  requestId        String
  publicId         String   @unique
  secureUrl        String
  originalFilename String
  resourceType     String
  format           String?
  bytes            Int
  mimeType         String?
  uploadedById     String
  createdAt        DateTime @default(now())

  request     CreativeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy  User            @relation("CreativeAssetUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([resourceType])
  @@map("creative_assets")
}

model SocialMediaPlan {
  id             String   @id @default(cuid())
  title          String
  clientName     String?
  platform       String?
  campaignName   String?
  scheduledFor   DateTime
  status         String   @default("planned") // planned, in_review, approved, published, archived
  captionHtml    String?  @db.Text
  adCopyHtml     String?  @db.Text
  briefHtml      String?  @db.Text
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy       User              @relation("SocialMediaPlanCreator", fields: [createdById], references: [id], onDelete: Cascade)
  creativeRequests CreativeRequest[]
  creativeDeliverables CreativeDeliverable[]

  @@index([scheduledFor])
  @@index([status])
  @@index([clientName])
  @@map("social_media_plans")
}
