# Database Configuration
DATABASE_URL="mysql://cportal_user:cPortal2024!Secure@localhost:3308/cportal_db"

# Application Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-use-openssl-to-generate

# Telegram Notifications
# Create a bot via @BotFather and get the token
# Get the chat ID by adding the bot to a group and using https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Amplitude Analytics
# Get your API key from https://app.amplitude.com > Settings > Projects
NEXT_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-api-key

# Cloudflare Turnstile (Bot Protection)
# Get your keys from https://dash.cloudflare.com > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Marketing Automations Service (external FastAPI service)
# Never expose these to the browser — only used server-side in src/app/api/marketing proxy routes
AUTOMATIONS_API_URL=https://automations.csl-brands.com
AUTOMATIONS_API_TOKEN=your-automations-service-token

# Eshu messaging platform (bulk SMS + WhatsApp)
# ESHU_API_KEY is a tenant API key minted in Eshu > Paramètres > Clés API.
# Never expose these to the browser — only used server-side in src/app/api/eshu proxy routes
ESHU_API_URL=https://eshu.olkoo.com
ESHU_API_KEY=eshu_live_your-tenant-api-key
